      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@xterm/headless": "^5.5.0",
    "colorette": "^2.0.20",
    "commander": "^12.0.0",
